OPENAI_API_KEY=
# Optional — only if AI_PROVIDER=groq
GROQ_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# gpt-5-mini is ignored — evaluations always use gpt-4o-mini so they finish quickly.
# Optional overrides (defaults in lib/transcripts/thresholds.ts):
# CHUNK_AT=12000
# MAX_CHARS=100000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON=
# Service role key (not the anon key). Required for create/process.
SUPABASE_SECRET=
# Local:
APP_URL=http://localhost:3000
# Vercel: override APP_URL to https://your-app.vercel.app (no trailing slash).
# OpenAI scores each call in one model request. Do not set AI_MODEL=gpt-5-mini.
# History UI hides evaluations created before this time (ISO-8601).
# HISTORY_STARTED_AT=2026-08-27T12:40:00.000Z
