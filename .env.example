OPENAI_API_KEY=
# Optional — only if AI_PROVIDER=groq
GROQ_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
# Optional overrides (defaults in lib/transcripts/thresholds.ts):
# CHUNK_AT=12000
# MAX_CHARS=100000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON=
# Service role key (not the anon key). Required for create/process.
SUPABASE_SECRET=
# Local:
APP_URL=http://localhost:3000
# Vercel: override APP_URL to https://your-app.vercel.app (no trailing slash).
# Long transcripts extract chunks in parallel automatically.
